[Unit]
Description=Local Telegram Bot API for large video uploads
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/dr-markaryan/telegram-api.env

[Service]
Type=simple
User=drmarkbot
Group=drmarkbot
EnvironmentFile=/etc/dr-markaryan/telegram-api.env
ExecStart=/opt/telegram-bot-api/bin/telegram-bot-api --local --http-ip-address=127.0.0.1 --http-port=8081 --dir=/var/lib/telegram-bot-api --temp-dir=/var/lib/telegram-bot-api/tmp --verbosity=0
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/telegram-bot-api
Nice=10
CPUQuota=100%
MemoryMax=700M
LimitNOFILE=65536
StandardOutput=append:/var/lib/telegram-bot-api/service.log
StandardError=append:/var/lib/telegram-bot-api/service.log

[Install]
WantedBy=multi-user.target
