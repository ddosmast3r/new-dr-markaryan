{
  "name": "dr-markaryan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сайт врача-проктолога, эндоскописта Эдуарда Маркаряна",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "check": "npm run lint",
    "check:all": "node scripts/check-all.mjs",
    "check:build": "NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "lint": "eslint .",
    "check:analytics": "node scripts/check-analytics-consent.mjs",
    "check:journeys": "node scripts/check-patient-journeys.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:mobile": "node scripts/check-mobile.mjs",
    "check:mobile:gate": "node scripts/check-mobile-gate.mjs",
    "prepare": "husky",
    "postinstall": "node scripts/patch-next.mjs",
    "instagram:import": "node scripts/import-instagram.mjs",
    "bot:start": "node --env-file-if-exists=.env.bot.local bot/index.mjs",
    "bot:test": "node --test bot/tests/*.test.mjs",
    "bot:test:site": "node bot/tests/site.integration.mjs"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.29",
    "husky": "^9.1.7",
    "playwright": "^1.61.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
