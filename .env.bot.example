# Copy to .env.bot.local (ignored by Git). Never put credentials in this example.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram IDs; supports three or more people.
# Empty means nobody can upload, edit or publish.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_API_URL=http://127.0.0.1:8081
TELEGRAM_API_FILES_DIR=/var/lib/telegram-bot-api
# The site and bot must use the same absolute path, outside the release directory.
VIDEO_DATA_DIR=/var/lib/dr-markaryan/videos
VIDEO_MAX_BYTES=2000000000
# Set false if the bot is on another server and publication is not connected yet.
VIDEO_PUBLISH_ENABLED=true
# Optional: publish to another server using a forced-command SSH key.
# VIDEO_SITE_SSH_HOST=217.149.30.67
# VIDEO_SITE_SSH_USER=drmarkpublish
# VIDEO_SITE_SSH_IDENTITY=/var/lib/dr-markaryan/videos/site-access/id_ed25519
# VIDEO_SITE_SSH_KNOWN_HOSTS=/var/lib/dr-markaryan/videos/site-access/known_hosts
